# Local override for apps/server. Copy to `.env` (gitignored) or export in the shell.
# Prefer the psycopg3 dialect. Bare `postgresql://` / `postgres://` URLs are
# rewritten to `postgresql+psycopg://` at load time.
DATABASE_URL=postgresql+psycopg://twerva:twerva@127.0.0.1:5432/twerva

# Public Spotmu origin (no secret). Client appends /api/v1/interests/slug/{slug}
# and /sitemap.xml. Default matches the 1.3a lock.
SPOTMU_API_BASE_URL=https://spotmu.com

# Local carousel PNGs (1.4). Production default is /opt/twerva/artifacts.
# For local README use: ./data/artifacts (relative to apps/server).
ARTIFACT_STORAGE_DIR=./data/artifacts

# Publish pipe (1.6). mock is the CI/default and needs no vendor keys.
# ayrshare is selected only when a live key exists; 1.6 does not send HTTP.
PUBLISH_ADAPTER=mock
# AYRSHARE_API_KEY=

# Unit text drafts. openai calls api.openai.com. fake drafts without a key.
# Leave the key empty to keep Generate off. Never commit a real key.
TEXT_GENERATION_PROVIDER=openai
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ops operator auth. SESSION_SECRET is required outside tests.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-local-only
# HttpOnly cookie; Secure=false for local HTTP (Vite / uvicorn).
SESSION_COOKIE_NAME=twerva_ops_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=43200
# Bootstrap only: used when ops_users is empty. Never commit real passwords.
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=change-me-local-only
# Local Vite origins (credentialed). Same-origin nginx does not need CORS.
OPS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
