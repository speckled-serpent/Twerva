# Local override for apps/server. Copy to `.env` (gitignored) or export in the shell.
# Prefer the psycopg3 dialect. Bare `postgresql://` / `postgres://` URLs are
# rewritten to `postgresql+psycopg://` at load time.
DATABASE_URL=postgresql+psycopg://twerva:twerva@127.0.0.1:5432/twerva

# Public Spotmu origin (no secret). Client appends /api/v1/interests/slug/{slug}
# and /sitemap.xml. Default matches the 1.3a lock.
SPOTMU_API_BASE_URL=https://spotmu.com

# Local carousel PNGs (1.4). Production default is /opt/twerva/artifacts.
# For local README use: ./data/artifacts (relative to apps/server).
ARTIFACT_STORAGE_DIR=./data/artifacts
